# GitHub Actions secrets for 0xdps/default-tamer.
# Copy to .env (gitignored) and run: just sync-secrets
#
# WEB_REPO_TOKEN is a fine-grained personal access token:
#   https://github.com/settings/personal-access-tokens/new
#   Resource owner: 0xdps
#   Repository access: 0xdps/default-tamer-web only
#   Permissions: Contents — Read and write
# SCRIPTS_DEPLOY_TOKEN also needs Contents read on that same repository.
WEB_REPO_TOKEN=

# Already stored on the repository. Fill these only when rotating them.
BUILD_CERTIFICATE_BASE64=
P12_PASSWORD=
KEYCHAIN_PASSWORD=
DEVELOPER_ID_NAME=
TEAM_ID=
APPLE_ID_USER=
APPLE_ID_TEAM=
APPLE_ID_PASSWORD=
SCRIPTS_DEPLOY_TOKEN=
SPARKLE_PRIVATE_KEY=
